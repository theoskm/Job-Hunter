# ---- Job sources (Phase 4) ----
# Free key: https://www.reed.co.uk/developers
REED_API_KEY=

# Free app_id + app_key: https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ---- AI analysis (Phase 6) ----
ANTHROPIC_API_KEY=

# ---- Gmail alerts (Phase 8) ----
GMAIL_SENDER_ADDRESS=
GMAIL_RECIPIENT_ADDRESS=
# Recommended: a Google app password (myaccount.google.com/apppasswords). Never expires.
GMAIL_APP_PASSWORD=
GOOGLE_OAUTH_CLIENT_SECRETS=credentials/gmail_oauth_client.json
GOOGLE_TOKEN_PATH=credentials/gmail_token.json

# ---- Google Sheets CRM (Phase 7) ----
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=credentials/service_account.json

# ---- Runtime ----
DATABASE_PATH=data/job_hunter.db
LOG_LEVEL=INFO
